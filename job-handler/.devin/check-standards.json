{
  "rules": {
    "dal-access": {
      "allowPaths": [
        "adapters/config-repository-adapter.ts",
        "db/dal.ts",
        "index.ts"
      ]
    },
    "layer-repo-import": {
      "appliesTo": [
        "controllers/"
      ]
    },
    "panel-footer-chrome": {
      "appliesTo": [
        "fe/src/"
      ]
    },
    "panel-toolbar-tools": {
      "appliesTo": [
        "fe/src/"
      ]
    },
    "panel-footer-start": {
      "appliesTo": [
        "fe/src/"
      ]
    },
    "panel-footer-cta": {
      "appliesTo": [
        "fe/src/"
      ]
    }
  },
  "i18n_namespaces": [
    "app",
    "job"
  ],
  "i18n_sql_exempt": [
    "0004_job_translations.sql",
    "0005_job_entity_labels.sql",
    "0012_job_rule_form.sql"
