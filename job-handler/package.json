{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "primebrick-job",
  "version": "3.6.2",
  "capabilities": [
    "job_orchestrator",
    "job_governance"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "predev": "pnpm check:standards",
    "version:auto": "node ../scripts/version-sync.mjs",
    "prebuild": "node ../scripts/version-sync.mjs && pnpm check:standards && pnpm db:check && pnpm generate:docs && pnpm fe:build",
    "dev": "node ../scripts/dev-hot.mjs",
    "db:migrate": "bun scripts/database-patch-apply.ts",
    "build": "tsc",
    "prestart": "pnpm run build",
    "start": "bun dist/index.js",
    "test": "pnpm check:standards && pnpm docs:check && vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "generate:docs": "bun src/index.ts --emit-docs",
    "docs:check": "bun src/index.ts --emit-docs --check",
    "check:standards": "bun ../../primebrick-v3-sdk/tools/check-standards.ts src",
    "db:check": "bun scripts/database-patch-check.ts",
    "fe:build": "vite build fe",
    "fe:check": "cd fe && svelte-check",
    "deploy": "node ../scripts/deploy-service.mjs job-handler",
    "db:meta:compare": "bun scripts/database-patch-compare.ts"
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@primebrick/dal-pg": "workspace:*",
    "@primebrick/sdk": "workspace:*",
    "croner": "10.0.1",
    "dotenv": "18.0.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@primebrick/ui": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "svelte": "5.57.2",
    "svelte-check": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  }
}
