{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "primebrick-job",
  "version": "3.1.0",
  "capabilities": [
    "job_orchestrator",
    "job_governance"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "version:auto": "node ../scripts/version-sync.mjs",
    "prebuild": "node ../scripts/version-sync.mjs && pnpm check:standards && pnpm db:check && pnpm generate:docs",
    "dev": "bun --hot src/index.ts",
    "db:migrate": "bun scripts/database-patch-apply.ts",
    "build": "tsc",
    "prestart": "pnpm run build",
    "start": "bun dist/index.js",
    "test": "pnpm check:standards && vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "generate:docs": "bun scripts/build-docs-pack.ts",
    "check:standards": "bun ../../primebrick-v3-sdk/tools/check-standards.ts src",
    "db:check": "bun node_modules/@primebrick/dal-pg/dist/cli/primebrick-db.js check --registry src/domain/entities/registry.ts --snapshot db-meta/snapshot-entities.json"
  },
  "dependencies": {
    "@primebrick/dal-pg": "workspace:*",
    "@primebrick/sdk": "workspace:*",
    "dotenv": "17.4.2",
    "nats": "2.29.3",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
