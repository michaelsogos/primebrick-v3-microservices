{
  "rules": {
    "dal-access": {
      "allowPaths": [
        "adapters/config-repository-adapter.ts",
        "db/dal.ts",
        "index.ts"
      ]
    },
    "layer-repo-import": {
      "appliesTo": [
        "controllers/"
      ]
    },
    "panel-footer-chrome": {
      "appliesTo": [
        "fe/src/"
      ]
    },
    "panel-toolbar-tools": {
      "appliesTo": [
        "fe/src/"
      ]
    },
    "panel-footer-start": {
      "appliesTo": [
        "fe/src/"
      ]
    },
    "panel-footer-cta": {
      "appliesTo": [
        "fe/src/"
      ]
    }
  },
  "i18n_namespaces": [
    "app",
    "system",
    "webhook"
  ],
  "i18n_key_ref_exempt": [
    "0002_seed_webhook_config.sql",
    "0003_seed_gateway_secret.sql",
    "0004_seed_be_base_url.sql"
  ]
}
