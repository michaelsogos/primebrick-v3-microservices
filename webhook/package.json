{
  "name": "primebrick-webhook",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "version:auto": "node ../scripts/version-sync.mjs",
    "prebuild": "node ../scripts/version-sync.mjs",
    "dev": "bun --hot src/index.ts",
    "build": "tsc",
    "prestart": "pnpm run build",
    "start": "bun dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "nats": "2.29.3",
    "dotenv": "17.4.2",
    "@primebrick/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
