# PostgreSQL connection — the ONLY env-sourced settings.
# Everything else lives in webhook.config_entries (nats_url, service_code,
# http_port, client_key, gateway_secret).
DATABASE_URL=postgres://primebrick:primebrick_dev@127.0.0.1:5432/primebrick
DB_SCHEMA=webhook

# Public base URL advertised in the service registry (dynamic host port in Docker)
SERVICE_BASE_URL=http://localhost:3005
