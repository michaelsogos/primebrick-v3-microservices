{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "primebrick-boilerplate",
  "version": "3.6.3",
  "capabilities": [],
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "predev": "pnpm check:standards && pnpm check:types",
    "version:auto": "node ../scripts/version-sync.mjs",
    "prebuild": "node ../scripts/version-sync.mjs && pnpm check:standards && pnpm db:check && pnpm generate:docs",
    "dev": "node ../scripts/dev-hot.mjs",
    "db:migrate": "bun scripts/database-patch-apply.ts",
    "build": "tsc",
    "prestart": "pnpm run build",
    "start": "bun dist/index.js",
    "test": "pnpm check:standards && pnpm docs:check && vitest run",
    "test:watch": "vitest",
    "generate:docs": "bun src/index.ts --emit-docs",
    "docs:check": "bun src/index.ts --emit-docs --check",
    "check:standards": "bun ../../primebrick-v3-sdk/tools/check-standards.ts src",
    "check:types": "tsc --noEmit",
    "db:check": "bun scripts/database-patch-check.ts",
    "db:meta:compare": "bun scripts/database-patch-compare.ts",
    "deploy": "node ../scripts/deploy-service.mjs boilerplate"
  },
  "dependencies": {
    "@primebrick/dal-pg": "workspace:*",
    "@primebrick/sdk": "workspace:*",
    "dotenv": "18.0.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  }
}
