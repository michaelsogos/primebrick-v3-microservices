{
  "rules": {
    "dal-access": {
      "allowPaths": [
        "db/dal.ts",
        "index.ts"
      ]
    },
    "layer-repo-import": {
      "appliesTo": [
        "controllers/"
      ]
    },
    "panel-footer-chrome": {
      "appliesTo": [
        "fe/src/"
      ]
    },
    "panel-toolbar-tools": {
      "appliesTo": [
        "fe/src/"
      ]
    },
    "panel-footer-start": {
      "appliesTo": [
        "fe/src/"
      ]
    },
    "panel-footer-cta": {
      "appliesTo": [
        "fe/src/"
      ]
    },
    "ext-json": {
      "allowPaths": [
        "providers/brevo.ts"
      ]
    },
    "no-fnf-nats-publish": {
      "allowPaths": [
        "services/email-service.ts"
      ]
    }
